class_name MapView
extends Control
## Zone map (дизайн 2.5, owner 27.11): top view rendered from the 3D blockout (assets/map/map_grounds.jpg),
## viewpoints as markers, paths between them, «you are here» with the gaze direction.
## Tap on a visited viewpoint → travel(vp). Not visited but known (a mark leads there) — hollow «?».
## Positions and headings: game_data.json "map" (from world/pano_anchors.yaml, generated by tools/render_panos.sh).

signal travel(vp_id: String)

const MARKER_R := 20.0
const TOUCH_R := 56.0            # ≥ 48 dp target

var _tex: Texture2D
var _time := 0.0


func _ready() -> void:
	mouse_filter = Control.MOUSE_FILTER_STOP
	_tex = Game.data.texture("map", str(Game.data.map_data().get("image", "")))


func _process(delta: float) -> void:
	_time += delta
	queue_redraw()


## Image rectangle inside the control (keep aspect, centred).
func image_rect() -> Rect2:
	if _tex == null:
		return Rect2(Vector2.ZERO, size)
	var ts := _tex.get_size()
	var k := minf(size.x / ts.x, size.y / ts.y)
	var s := ts * k
	return Rect2((size - s) * 0.5, s)


func marker_pos(vp_id: String) -> Vector2:
	var m := Game.data.map_vp(vp_id)
	var r := image_rect()
	return r.position + Vector2(float(m.get("u", 0.5)), float(m.get("v", 0.5))) * r.size


func visited(vp_id: String) -> bool:
	return Game.state.has("vp." + vp_id)


## Visited viewpoints and the ones a visible transition mark leads to.
func known() -> Array:
	var out: Array = []
	for vp_id in Game.data.map_data().get("viewpoints", {}):
		if visited(vp_id):
			if not (vp_id in out):
				out.append(vp_id)
			for ex in Game.data.viewpoint(vp_id).get("exits", []):
				if not (ex["to"] in out) and not Game.data.map_vp(ex["to"]).is_empty():
					out.append(ex["to"])
	return out


func _draw() -> void:
	var r := image_rect()
	if _tex:
		draw_texture_rect(_tex, r, false)
		draw_rect(r, Color(UiKit.IVORY, 0.08))
	else:
		draw_rect(r, UiKit.FOG.darkened(0.3))
	draw_rect(r, UiKit.WALNUT, false, 3.0)
	var kn := known()
	# paths between places (ink dashes)
	var drawn := {}
	for vp_id in kn:
		if not visited(vp_id):
			continue
		for ex in Game.data.viewpoint(vp_id).get("exits", []):
			var to: String = ex["to"]
			var key := "%s|%s" % [mini(vp_id.hash(), to.hash()), maxi(vp_id.hash(), to.hash())]
			if to in kn and not drawn.has(key):
				drawn[key] = true
				draw_dashed_line(marker_pos(vp_id), marker_pos(to), Color(UiKit.IVORY, 0.9), 5.0, 14.0)
				draw_dashed_line(marker_pos(vp_id), marker_pos(to), Color(UiKit.INK, 0.9), 2.5, 14.0)
	# gaze cone of the current viewpoint
	var cur := Game.state.vp
	if cur in kn:
		var c := marker_pos(cur)
		var hd := float(Game.data.map_vp(cur).get("heading", 0.0)) + Game.state.yaw
		var pts := PackedVector2Array([c])
		for i in 13:
			var a := deg_to_rad(hd - 35.0 + 70.0 * i / 12.0)
			pts.append(c + Vector2(sin(a), -cos(a)) * 90.0)
		draw_colored_polygon(pts, Color(UiKit.LAMP, 0.45))
		draw_polyline(pts + PackedVector2Array([c]), Color(UiKit.INK, 0.7), 2.0)
	var font := ThemeDB.fallback_font
	var taken: Array = []          # label rects + marker boxes already used (labels must not cover each other)
	for vp_id in kn:
		var mp := marker_pos(vp_id)
		taken.append(Rect2(mp - Vector2(MARKER_R, MARKER_R), Vector2(MARKER_R, MARKER_R) * 2.0))
	for vp_id in kn:
		var p := marker_pos(vp_id)
		var is_cur: bool = vp_id == cur
		if visited(vp_id):
			if is_cur:
				var ring := MARKER_R + 6.0 + 5.0 * (0.5 + 0.5 * sin(_time * 4.0))
				draw_arc(p, ring, 0, TAU, 32, UiKit.LAMP, 4.0)
			draw_circle(p, MARKER_R, UiKit.LAMP if is_cur else UiKit.BRASS)
			draw_arc(p, MARKER_R, 0, TAU, 32, UiKit.INK, 3.0)
			if is_cur:
				draw_circle(p, 7.0, UiKit.INK)
		else:
			draw_circle(p, MARKER_R, Color(UiKit.IVORY, 0.6))
			for i in 12:
				var a0 := TAU * i / 12.0
				draw_arc(p, MARKER_R, a0, a0 + TAU / 24.0, 4, UiKit.INK, 3.0)
			draw_string(font, p + Vector2(-8, 10), "?", HORIZONTAL_ALIGNMENT_LEFT, -1, 30, UiKit.INK)
		var text := Game.t("vp." + vp_id)
		if is_cur:
			text += " · " + Game.t("map.you_are_here")
		var fs := 26
		var sz := Vector2(font.get_string_size(text, HORIZONTAL_ALIGNMENT_LEFT, -1, fs).x + 20.0, fs + 12.0)
		var rect := _label_rect(p, sz, r, taken)
		taken.append(rect)
		draw_rect(rect, Color(UiKit.LAKE_DUSK, 0.88 if visited(vp_id) else 0.6))
		draw_string(font, rect.position + Vector2(10, fs + 2), text, HORIZONTAL_ALIGNMENT_LEFT, -1, fs, UiKit.IVORY if visited(vp_id) else UiKit.FOG.lightened(0.2))


## First free place for a label: right, left, above, below the marker (inside the image if possible).
func _label_rect(p: Vector2, sz: Vector2, bounds: Rect2, taken: Array) -> Rect2:
	var cands := [
		Rect2(p + Vector2(MARKER_R + 8.0, -sz.y * 0.5), sz),
		Rect2(p + Vector2(-MARKER_R - 8.0 - sz.x, -sz.y * 0.5), sz),
		Rect2(p + Vector2(-sz.x * 0.5, -MARKER_R - 6.0 - sz.y), sz),
		Rect2(p + Vector2(-sz.x * 0.5, MARKER_R + 6.0), sz),
	]
	for c in cands:
		if not bounds.encloses(c):
			continue
		var free := true
		for t in taken:
			if c.intersects(t):
				free = false
				break
		if free:
			return c
	return cands[0]


## Visited viewpoint under a point (for taps and tests), "" if none.
func vp_at(pos: Vector2) -> String:
	var best := ""
	var best_d := TOUCH_R
	for vp_id in known():
		if not visited(vp_id):
			continue
		var d := pos.distance_to(marker_pos(vp_id))
		if d < best_d:
			best_d = d
			best = vp_id
	return best


func _gui_input(ev: InputEvent) -> void:
	if ev is InputEventScreenTouch and not ev.pressed:
		var vp_id := vp_at(ev.position)
		if vp_id != "" and vp_id != Game.state.vp:
			travel.emit(vp_id)
		accept_event()
